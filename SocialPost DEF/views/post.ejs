<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social PostIt — Nuovo Post</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* ── VARIABILI & RESET ─────────────────────────────────── */
        :root {
            --bg:       #06080f;
            --bg2:      #0a0d1a;
            --cyan:     #00e5ff;
            --pink:     #ff2070;
            --green:    #00ff9f;
            --text:     #c8d6e5;
            --muted:    #566a80;
            --border:   rgba(0, 229, 255, 0.18);
            --glow-c:   rgba(0, 229, 255, 0.35);
            --glow-p:   rgba(255, 32, 112, 0.35);
            --danger:   #ff4b6a;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* ── SFONDO CSS ─────────────────────────────────────────── */
        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background-color: var(--bg);
            min-height: 100vh;
            display: flex; flex-direction: column;
        }
        body::before {
            content: '';
            position: fixed; inset: 0;
            background:
                linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
            background-size: 44px 44px;
            z-index: -2; pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed; inset: 0;
            background: repeating-linear-gradient(
                0deg, transparent, transparent 3px,
                rgba(0,0,0,0.12) 3px, rgba(0,0,0,0.12) 4px
            );
            z-index: -1; pointer-events: none;
        }
        .cyber-orb {
            position: fixed; width: 700px; height: 700px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(0,229,255,0.05) 0%, transparent 70%);
            top: -300px; right: -250px; z-index: -1; pointer-events: none;
            animation: orb-pulse 8s ease-in-out infinite;
        }
        .cyber-orb-2 {
            position: fixed; width: 400px; height: 400px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(255,32,112,0.04) 0%, transparent 70%);
            bottom: -150px; left: -100px; z-index: -1; pointer-events: none;
            animation: orb-pulse 10s ease-in-out infinite reverse;
        }
        @keyframes orb-pulse {
            0%,100% { opacity:1; transform:scale(1); }
            50%      { opacity:0.5; transform:scale(1.08); }
        }

        /* ── NAVBAR ─────────────────────────────────────────────── */
        .navbar {
            background: rgba(6,8,15,0.92) !important;
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 10px 0;
        }
        .navbar-brand {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px; font-weight: 700;
            color: var(--cyan) !important;
            letter-spacing: 2px; text-transform: uppercase;
            text-shadow: 0 0 12px var(--glow-c);
        }
        .navbar-brand span { color: var(--pink); text-shadow: 0 0 12px var(--glow-p); }
        .navbar-brand::before {
            content: '//'; color: var(--muted); margin-right: 8px;
            font-size: 14px; font-family: 'Share Tech Mono', monospace;
        }
        .nav-user-tag {
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px; color: var(--muted);
        }
        .nav-user-tag span { color: var(--cyan); text-shadow: 0 0 8px var(--glow-c); }
        .btn-nav {
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px; font-weight: 600;
            letter-spacing: 1px; text-transform: uppercase;
            border-radius: 4px; padding: 5px 14px;
            text-decoration: none; transition: all 0.2s; display: inline-block;
        }
        .btn-nav-green {
            color: var(--green); border: 1px solid rgba(0,255,159,0.35);
        }
        .btn-nav-green:hover {
            background: rgba(0,255,159,0.08); border-color: var(--green);
            box-shadow: 0 0 12px rgba(0,255,159,0.2); color: var(--green);
        }

        /* ── CONTENUTO PRINCIPALE ───────────────────────────────── */
        .post-wrapper {
            flex: 1; display: flex; align-items: flex-start;
            justify-content: center; padding: 50px 16px 80px;
        }
        .post-form-card {
            width: 100%; max-width: 700px;
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 8px; padding: 42px 40px;
            position: relative; overflow: hidden;
            animation: slide-in 0.4s ease both;
        }
        @keyframes slide-in {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        /* Barra superiore ciano */
        .post-form-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 2px;
            background: linear-gradient(90deg, var(--cyan), var(--pink), transparent 80%);
        }
        /* Bordo verticale sinistra */
        .post-form-card::after {
            content: '';
            position: absolute; top: 0; left: 0;
            width: 2px; height: 90px;
            background: linear-gradient(180deg, var(--cyan), transparent);
        }

        .form-label-tag {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--muted);
            letter-spacing: 3px; text-transform: uppercase; margin-bottom: 6px;
        }
        .form-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 30px; font-weight: 700;
            color: var(--text); letter-spacing: 1px; margin-bottom: 30px;
        }
        .form-title span { color: var(--cyan); text-shadow: 0 0 12px var(--glow-c); }

        /* ── FORM INPUTS ────────────────────────────────────────── */
        .field-group { margin-bottom: 22px; }
        .field-group label {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--muted);
            letter-spacing: 1.5px; text-transform: uppercase;
            display: block; margin-bottom: 7px;
        }
        .form-control {
            background: rgba(14,18,37,0.8) !important;
            border: 1px solid rgba(86,106,128,0.4) !important;
            border-radius: 4px !important;
            color: var(--text) !important;
            font-size: 14px !important;
            padding: 10px 14px !important;
            transition: border-color 0.2s, box-shadow 0.2s !important;
            width: 100%;
        }
        .form-control::placeholder { color: var(--muted) !important; }
        .form-control:focus {
            border-color: var(--cyan) !important;
            box-shadow: 0 0 0 3px rgba(0,229,255,0.1) !important;
            outline: none !important;
            background: rgba(0,229,255,0.03) !important;
        }
        textarea.form-control {
            min-height: 180px !important;
            resize: vertical !important;
            line-height: 1.7 !important;
        }

        /* Contatore caratteri */
        .char-counter {
            font-family: 'Share Tech Mono', monospace;
            font-size: 10px; color: var(--muted);
            text-align: right; margin-top: 4px;
            transition: color 0.2s;
        }
        .char-counter.warn  { color: #ffd600; }
        .char-counter.limit { color: var(--danger); }

        /* ── UPLOAD IMMAGINE ────────────────────────────────────── */
        /* L'input file nativo è nascosto; viene attivato dal div personalizzato */
        .img-upload-area {
            border: 1px dashed rgba(0,229,255,0.3);
            border-radius: 4px; padding: 20px;
            text-align: center; cursor: pointer;
            transition: all 0.2s; position: relative;
            background: rgba(0,229,255,0.02);
        }
        .img-upload-area:hover {
            border-color: var(--cyan);
            background: rgba(0,229,255,0.05);
            box-shadow: 0 0 12px rgba(0,229,255,0.1);
        }
        .img-upload-area.drag-over {
            border-color: var(--green);
            background: rgba(0,255,159,0.05);
        }
        .img-upload-area .upload-icon { font-size: 28px; margin-bottom: 6px; }
        .img-upload-area p {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--muted); letter-spacing: 1px;
        }
        /* Input file nativo nascosto ma accessibile */
        #imageFile {
            position: absolute; inset: 0;
            opacity: 0; cursor: pointer; width: 100%; height: 100%;
        }

        /* Anteprima immagine selezionata */
        .img-preview-wrap {
            display: none; position: relative; margin-top: 10px;
        }
        .img-preview-wrap img {
            max-width: 100%; max-height: 220px;
            object-fit: cover; border-radius: 4px;
            border: 1px solid rgba(0,229,255,0.2);
        }
        .img-remove-btn {
            position: absolute; top: 6px; right: 6px;
            background: rgba(255,32,112,0.8); color: white;
            border: none; border-radius: 50%;
            width: 24px; height: 24px;
            font-size: 14px; line-height: 24px; text-align: center;
            cursor: pointer; transition: background 0.2s;
        }
        .img-remove-btn:hover { background: var(--pink); }

        /* Input nascosto che conterrà la stringa base64 */
        #imageBase64 { display: none; }

        /* ── TAG INPUT ──────────────────────────────────────────── */
        .tags-hint {
            font-family: 'Share Tech Mono', monospace;
            font-size: 10px; color: var(--muted);
            margin-top: 4px; letter-spacing: 0.5px;
        }

        /* ── PULSANTE PUBLISH ───────────────────────────────────── */
        .btn-publish {
            width: 100%; padding: 13px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 15px; font-weight: 700;
            letter-spacing: 2px; text-transform: uppercase;
            color: var(--bg); background: var(--cyan);
            border: none; border-radius: 4px; cursor: pointer;
            transition: box-shadow 0.2s, transform 0.15s;
            margin-top: 6px;
        }
        .btn-publish:hover {
            box-shadow: 0 0 28px var(--glow-c);
            transform: translateY(-1px);
        }
        .btn-publish:active { transform: translateY(0); }

        /* ── ERRORE ─────────────────────────────────────────────── */
        .form-error {
            background: rgba(255,75,106,0.1);
            border: 1px solid rgba(255,75,106,0.35);
            border-radius: 4px; padding: 10px 14px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px; color: var(--danger); margin-bottom: 20px;
        }
        .form-error::before { content: '⚠ '; }

        /* ── SEPARATORE ─────────────────────────────────────────── */
        .field-divider {
            border: none; border-top: 1px solid rgba(0,229,255,0.1);
            margin: 24px 0;
        }
    </style>
</head>
<body>
    <div class="cyber-orb"></div>
    <div class="cyber-orb-2"></div>

    <!-- ── NAVBAR ──────────────────────────────────────────────── -->
    <nav class="navbar navbar-dark">
        <div class="container d-flex align-items-center gap-3">
            <a class="navbar-brand" href="/">Social <span>PostIt</span></a>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a href="/chat" class="btn-nav btn-nav-green">Chat Live</a>
                <span class="nav-user-tag">> <span><%= currentUser %></span></span>
            </div>
        </div>
    </nav>

    <!-- ── FORM NUOVO POST ─────────────────────────────────────── -->
    <div class="post-wrapper">
        <div class="post-form-card">
            <div class="form-label-tag">// Nuovo contenuto</div>
            <div class="form-title">Crea un <span>Post</span></div>

            <% if (error) { %>
                <div class="form-error"><%= error %></div>
            <% } %>

            <!--
                Il form invia dati in formato URL-encoded (default Express).
                L'immagine viene convertita in base64 lato client e inserita
                nel campo nascosto #imageBase64 prima dell'invio.
                Il server legge il campo 'image' da req.body (nessuna libreria extra).
            -->
            <form id="postForm" action="/post" method="POST">
                <!-- Titolo -->
                <div class="field-group">
                    <label for="title">Titolo</label>
                    <input type="text" id="title" name="title"
                           class="form-control" placeholder="Titolo del post" required
                           maxlength="120">
                </div>

                <!-- Contenuto con contatore caratteri -->
                <div class="field-group">
                    <label for="content">Contenuto</label>
                    <textarea id="content" name="content"
                              class="form-control"
                              placeholder="Scrivi il tuo post..."
                              required maxlength="2000"
                              oninput="updateCounter(this)"></textarea>
                    <div class="char-counter" id="charCounter">0 / 2000</div>
                </div>

                <hr class="field-divider">

                <!-- Upload immagine -->
                <div class="field-group">
                    <label>Immagine allegata <span style="color:var(--muted);font-size:9px">(opzionale · max 5 MB)</span></label>

                    <!-- Area drag-and-drop personalizzata -->
                    <div class="img-upload-area" id="uploadArea"
                         ondragover="handleDragOver(event)"
                         ondragleave="handleDragLeave(event)"
                         ondrop="handleDrop(event)">
                        <!-- Input file nativo (trasparente, copre tutta l'area) -->
                        <input type="file" id="imageFile"
                               accept="image/jpeg,image/png,image/gif,image/webp"
                               onchange="handleImageSelect(this.files[0])">
                        <div class="upload-icon">📎</div>
                        <p>Clicca o trascina un'immagine qui</p>
                        <p style="font-size:9px;margin-top:4px">JPG · PNG · GIF · WEBP</p>
                    </div>

                    <!-- Anteprima dell'immagine selezionata -->
                    <div class="img-preview-wrap" id="imgPreview">
                        <img id="previewImg" src="" alt="Anteprima">
                        <button type="button" class="img-remove-btn"
                                onclick="removeImage()" title="Rimuovi immagine">✕</button>
                    </div>

                    <!--
                        Campo nascosto che verrà popolato dal JavaScript con
                        la stringa data URL (base64) dell'immagine compressa.
                        Il server la riceve come req.body.image.
                    -->
                    <input type="hidden" name="image" id="imageBase64">
                </div>

                <hr class="field-divider">

                <!-- Tag/Hashtag -->
                <div class="field-group">
                    <label for="tags">Tag <span style="color:var(--muted);font-size:9px">(opzionali)</span></label>
                    <input type="text" id="tags" name="tags"
                           class="form-control"
                           placeholder="es: tecnologia, gaming, arte">
                    <div class="tags-hint">Separa più tag con la virgola. Il simbolo # è aggiunto automaticamente.</div>
                </div>

                <button type="submit" class="btn-publish" id="publishBtn">
                    Pubblica
                </button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        /* ── CONTATORE CARATTERI ─────────────────────────────────── */
        // Aggiorna il contatore caratteri del textarea in tempo reale
        function updateCounter(el) {
            const len     = el.value.length;
            const max     = parseInt(el.getAttribute('maxlength'), 10);
            const counter = document.getElementById('charCounter');
            counter.textContent = `${len} / ${max}`;
            counter.className   = 'char-counter';
            if (len > max * 0.9)  counter.classList.add('warn');
            if (len >= max)       counter.classList.add('limit');
        }

        /* ── GESTIONE IMMAGINE ───────────────────────────────────── */
        const MAX_BYTES  = 5 * 1024 * 1024; // Limite 5 MB pre-compressione
        const MAX_PX     = 900;             // Dimensione massima in pixel
        const JPEG_QUAL  = 0.75;            // Qualità JPEG dopo compressione

        // Chiamata quando l'utente seleziona un file con l'input
        function handleImageSelect(file) {
            if (!file) return;
            if (!file.type.startsWith('image/')) {
                alert('Seleziona un file immagine valido (JPG, PNG, GIF, WEBP).');
                return;
            }
            if (file.size > MAX_BYTES) {
                alert(`L'immagine supera il limite di 5 MB. Dimensione: ${(file.size/1024/1024).toFixed(1)} MB`);
                clearImageInput();
                return;
            }
            // Legge il file e lo comprime via Canvas
            const reader = new FileReader();
            reader.onload = e => compressAndPreview(e.target.result);
            reader.readAsDataURL(file);
        }

        // Gestione del drag-over
        function handleDragOver(e) {
            e.preventDefault();
            document.getElementById('uploadArea').classList.add('drag-over');
        }

        // Gestione del drag-leave
        function handleDragLeave(e) {
            document.getElementById('uploadArea').classList.remove('drag-over');
        }

        // Gestione del drop
        function handleDrop(e) {
            e.preventDefault();
            document.getElementById('uploadArea').classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file) handleImageSelect(file);
        }

        // Riduce le dimensioni dell'immagine tramite Canvas HTML5 e ne
        // estrae la stringa base64 (data URL) da inserire nel campo nascosto.
        // Non richiede alcuna libreria esterna.
        function compressAndPreview(dataUrl) {
            const img = new Image();
            img.onload = function() {
                // Calcola le nuove dimensioni mantenendo il rapporto
                let w = img.width, h = img.height;
                if (w > MAX_PX || h > MAX_PX) {
                    if (w > h) { h = Math.round(h * MAX_PX / w); w = MAX_PX; }
                    else       { w = Math.round(w * MAX_PX / h); h = MAX_PX; }
                }
                // Disegna su canvas e ottieni il data URL compresso
                const canvas  = document.createElement('canvas');
                canvas.width  = w; canvas.height = h;
                canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                const compressed = canvas.toDataURL('image/jpeg', JPEG_QUAL);

                // Popola il campo nascosto (letto dal server come req.body.image)
                document.getElementById('imageBase64').value = compressed;

                // Mostra l'anteprima all'utente
                document.getElementById('previewImg').src   = compressed;
                document.getElementById('imgPreview').style.display = 'block';
                document.getElementById('uploadArea').style.display = 'none';
            };
            img.src = dataUrl;
        }

        // Rimuove l'immagine selezionata e ripristina il form
        function removeImage() {
            clearImageInput();
        }

        function clearImageInput() {
            document.getElementById('imageBase64').value = '';
            document.getElementById('previewImg').src    = '';
            document.getElementById('imgPreview').style.display  = 'none';
            document.getElementById('uploadArea').style.display  = 'block';
            document.getElementById('imageFile').value = '';
        }

        /* ── VALIDAZIONE PRE-INVIO ───────────────────────────────── */
        document.getElementById('postForm').addEventListener('submit', function(e) {
            const btn = document.getElementById('publishBtn');
            btn.textContent = 'Pubblicazione in corso...';
            btn.disabled    = true;
            // Se l'invio fallisce, ripristina il pulsante dopo 5s
            setTimeout(() => { btn.textContent = 'Pubblica'; btn.disabled = false; }, 5000);
        });
    </script>
</body>
</html>
