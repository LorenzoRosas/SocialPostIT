<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social PostIt — Chat Live</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* ── VARIABILI & RESET ─────────────────────────────────── */
        :root {
            --bg:       #06080f;
            --bg2:      #0a0d1a;
            --bg3:      #070a14;
            --cyan:     #00e5ff;
            --pink:     #ff2070;
            --green:    #00ff9f;
            --yellow:   #ffd600;
            --text:     #c8d6e5;
            --muted:    #566a80;
            --border:   rgba(0, 229, 255, 0.18);
            --glow-c:   rgba(0, 229, 255, 0.35);
            --glow-p:   rgba(255, 32, 112, 0.35);
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* ── SFONDO CSS ─────────────────────────────────────────── */
        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background-color: var(--bg);
            min-height: 100vh;
            display: flex; flex-direction: column;
            overflow-x: hidden;
        }
        body::before {
            content: '';
            position: fixed; inset: 0;
            background:
                linear-gradient(rgba(0,229,255,0.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,229,255,0.025) 1px, transparent 1px);
            background-size: 44px 44px;
            z-index: -2; pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed; inset: 0;
            background: repeating-linear-gradient(
                0deg, transparent, transparent 3px,
                rgba(0,0,0,0.12) 3px, rgba(0,0,0,0.12) 4px
            );
            z-index: -1; pointer-events: none;
        }
        .cyber-orb {
            position: fixed; width: 600px; height: 600px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(0,229,255,0.045) 0%, transparent 70%);
            top: -250px; right: -200px; z-index: -1; pointer-events: none;
            animation: orb-pulse 8s ease-in-out infinite;
        }
        .cyber-orb-2 {
            position: fixed; width: 400px; height: 400px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(255,32,112,0.04) 0%, transparent 70%);
            bottom: -150px; left: -100px; z-index: -1; pointer-events: none;
            animation: orb-pulse 10s ease-in-out infinite reverse;
        }
        @keyframes orb-pulse {
            0%,100% { opacity:1; transform:scale(1); }
            50%      { opacity:0.6; transform:scale(1.06); }
        }

        /* ── NAVBAR ─────────────────────────────────────────────── */
        .navbar {
            background: rgba(6,8,15,0.92) !important;
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 10px 0; flex-shrink: 0;
        }
        .navbar-brand {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px; font-weight: 700;
            color: var(--cyan) !important;
            letter-spacing: 2px; text-transform: uppercase;
            text-shadow: 0 0 12px var(--glow-c);
        }
        .navbar-brand span { color: var(--pink); text-shadow: 0 0 12px var(--glow-p); }
        .navbar-brand::before {
            content: '//'; color: var(--muted); margin-right: 8px;
            font-size: 14px; font-family: 'Share Tech Mono', monospace;
        }
        .nav-user-tag {
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px; color: var(--muted); margin-right: 2px;
        }
        .nav-user-tag span { color: var(--green); text-shadow: 0 0 8px rgba(0,255,159,0.4); }
        /* Pallino status online */
        .online-dot {
            display: inline-block; width: 7px; height: 7px;
            border-radius: 50%; background: var(--green);
            box-shadow: 0 0 6px var(--green); margin-right: 6px;
            animation: blink 2s ease-in-out infinite;
        }
        @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

        .btn-nav {
            font-family: 'Rajdhani', sans-serif;
            font-size: 12px; font-weight: 600;
            letter-spacing: 1px; text-transform: uppercase;
            border-radius: 4px; padding: 5px 12px;
            text-decoration: none; transition: all 0.2s; display: inline-block;
        }
        .btn-nav-cyan {
            color: var(--cyan); border: 1px solid rgba(0,229,255,0.3);
        }
        .btn-nav-cyan:hover {
            background: rgba(0,229,255,0.08); border-color: var(--cyan);
            box-shadow: 0 0 12px rgba(0,229,255,0.2); color: var(--cyan);
        }
        .btn-nav-pink {
            color: var(--pink); border: 1px solid rgba(255,32,112,0.3);
        }
        .btn-nav-pink:hover {
            background: rgba(255,32,112,0.08); border-color: var(--pink);
            box-shadow: 0 0 12px rgba(255,32,112,0.2); color: var(--pink);
        }

        /* ── LAYOUT CHAT ────────────────────────────────────────── */
        .chat-layout {
            flex: 1; display: flex; flex-direction: column;
            padding: 18px 16px 20px;
            max-width: 860px; width: 100%;
            margin: 0 auto; min-height: 0;
        }

        /* Intestazione chat */
        .chat-header {
            display: flex; align-items: center; gap: 12px; margin-bottom: 14px;
        }
        .chat-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 22px; font-weight: 700;
            color: var(--text); letter-spacing: 1px;
        }
        .chat-title span { color: var(--cyan); text-shadow: 0 0 10px var(--glow-c); }
        .chat-subtitle {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--muted);
            letter-spacing: 2px; margin-left: auto;
        }
        /* Contatore utenti online */
        .online-count {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--green);
            letter-spacing: 1px;
            background: rgba(0,255,159,0.06);
            border: 1px solid rgba(0,255,159,0.2);
            border-radius: 20px; padding: 3px 10px;
            display: flex; align-items: center; gap: 6px;
        }
        .online-count .dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--green); box-shadow: 0 0 5px var(--green);
            animation: blink 2s infinite;
        }

        /* ── AREA MESSAGGI ──────────────────────────────────────── */
        #messages {
            flex: 1; background: var(--bg3);
            border: 1px solid var(--border); border-radius: 6px;
            padding: 16px; overflow-y: auto; min-height: 0;
            height: calc(100vh - 290px);
            scrollbar-width: thin; scrollbar-color: rgba(0,229,255,0.3) transparent;
            margin-bottom: 10px;
        }
        #messages::-webkit-scrollbar { width: 5px; }
        #messages::-webkit-scrollbar-track { background: transparent; }
        #messages::-webkit-scrollbar-thumb { background: rgba(0,229,255,0.25); border-radius: 3px; }

        /* ── MESSAGGI ───────────────────────────────────────────── */
        .message {
            margin-bottom: 10px; max-width: 78%;
            word-wrap: break-word;
            animation: msg-in 0.22s ease;
        }
        @keyframes msg-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }

        /* Miei messaggi (destra) */
        .my-message {
            margin-left: auto;
            background: rgba(0,229,255,0.08);
            border: 1px solid rgba(0,229,255,0.22);
            border-radius: 8px 2px 8px 8px; padding: 9px 14px;
        }
        /* Messaggi altrui (sinistra) */
        .other-message {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 2px 8px 8px 8px; padding: 9px 14px;
        }
        /* Messaggi di sistema (centrati) */
        .system-message {
            max-width: 100%; text-align: center;
            margin: 10px auto;
        }
        .system-message .message-content {
            font-family: 'Share Tech Mono', monospace;
            font-size: 10px; color: var(--yellow);
            letter-spacing: 1px; display: inline-block;
            background: rgba(255,214,0,0.06);
            border: 1px solid rgba(255,214,0,0.15);
            border-radius: 3px; padding: 3px 10px;
        }
        .message-header {
            display: flex; align-items: center; gap: 8px; margin-bottom: 4px;
        }
        .message-username {
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px; font-weight: 700;
            color: var(--cyan); letter-spacing: 0.5px;
        }
        .my-message .message-username { color: var(--green); }
        .message-time {
            font-family: 'Share Tech Mono', monospace;
            font-size: 9px; color: var(--muted); margin-left: auto;
        }
        .message-content { font-size: 14px; line-height: 1.55; color: var(--text); }

        /* Indicatore di digitazione */
        #typing-indicator {
            font-family: 'Share Tech Mono', monospace;
            font-size: 10px; color: var(--muted);
            min-height: 18px; letter-spacing: 0.5px;
            margin-bottom: 6px; padding-left: 4px;
            transition: opacity 0.3s;
        }

        /* ── BARRA EMOJI ────────────────────────────────────────── */
        .emoji-bar {
            display: flex; gap: 4px; flex-wrap: wrap;
            margin-bottom: 8px; padding: 0 2px;
        }
        .emoji-btn {
            background: rgba(0,229,255,0.05);
            border: 1px solid rgba(0,229,255,0.12);
            border-radius: 4px; padding: 3px 7px;
            font-size: 16px; cursor: pointer;
            transition: all 0.15s; line-height: 1;
        }
        .emoji-btn:hover {
            background: rgba(0,229,255,0.12);
            border-color: rgba(0,229,255,0.35);
            transform: scale(1.15);
        }

        /* ── INPUT ROW ──────────────────────────────────────────── */
        .input-row { display: flex; gap: 8px; align-items: center; }
        #messageInput {
            flex: 1; background: rgba(10,13,26,0.95);
            border: 1px solid rgba(0,229,255,0.2); border-radius: 4px;
            color: var(--text); font-size: 14px;
            padding: 10px 14px; outline: none;
            font-family: 'Inter', sans-serif;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        #messageInput:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(0,229,255,0.1);
        }
        #messageInput::placeholder { color: var(--muted); }
        #sendBtn {
            padding: 10px 20px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 14px; font-weight: 700;
            letter-spacing: 1.5px; text-transform: uppercase;
            color: var(--bg); background: var(--cyan);
            border: none; border-radius: 4px; cursor: pointer;
            transition: box-shadow 0.2s, transform 0.15s; flex-shrink: 0;
        }
        #sendBtn:hover { box-shadow: 0 0 20px var(--glow-c); transform: translateY(-1px); }
        #sendBtn:active { transform: translateY(0); }
        #sendBtn:disabled {
            background: var(--muted); cursor: not-allowed;
            box-shadow: none; transform: none;
        }

        /* ── STATUS CONNESSIONE ─────────────────────────────────── */
        #conn-status {
            font-family: 'Share Tech Mono', monospace;
            font-size: 10px; letter-spacing: 1px;
            margin-top: 6px; text-align: right; transition: color 0.3s;
        }
        #conn-status.connected    { color: var(--green); }
        #conn-status.disconnected { color: var(--pink); }
    </style>
</head>
<body>
    <div class="cyber-orb"></div>
    <div class="cyber-orb-2"></div>

    <!-- ── NAVBAR ──────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Social <span>PostIt</span></a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <% if (currentUser) { %>
                    <span class="online-dot"></span>
                    <span class="nav-user-tag"><span><%= currentUser %></span></span>
                    <a href="/"       class="btn-nav btn-nav-cyan">Home</a>
                    <a href="/post"   class="btn-nav btn-nav-cyan">Nuovo Post</a>
                    <a href="/logout" class="btn-nav btn-nav-pink">Esci</a>
                <% } else { %>
                    <a href="/login" class="btn-nav btn-nav-cyan">Accedi</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- ── CHAT ────────────────────────────────────────────────── -->
    <div class="chat-layout">
        <!-- Intestazione con titolo e contatore online -->
        <div class="chat-header">
            <div class="chat-title"><span>Chat</span> Live</div>
            <div class="chat-subtitle">// WEBSOCKET REAL-TIME</div>
            <div class="online-count" id="onlineCount">
                <span class="dot"></span>
                <span id="onlineNum">1</span> online
            </div>
        </div>

        <!-- Messaggi -->
        <div id="messages">
            <div class="message system-message">
                <div class="message-content">Connessione al server in corso...</div>
            </div>
        </div>

        <!-- Indicatore di digitazione (aggiornato via WebSocket) -->
        <div id="typing-indicator"></div>

        <!-- Barra emoji rapida -->
        <div class="emoji-bar" id="emojiBar">
            <!-- Le emoji vengono generate dal JavaScript -->
        </div>

        <!-- Input messaggio -->
        <form id="messageForm">
            <div class="input-row">
                <input type="text" id="messageInput"
                       placeholder="Scrivi un messaggio... (Invio per inviare)"
                       autocomplete="off" maxlength="500">
                <button type="submit" id="sendBtn" disabled>Invia</button>
            </div>
        </form>
        <div id="conn-status" class="disconnected">● DISCONNESSO</div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ── VARIABILI DOM ────────────────────────────────────────
        const messagesContainer = document.getElementById('messages');
        const messageForm       = document.getElementById('messageForm');
        const messageInput      = document.getElementById('messageInput');
        const sendBtn           = document.getElementById('sendBtn');
        const connStatus        = document.getElementById('conn-status');
        const typingIndicator   = document.getElementById('typing-indicator');
        const onlineNum         = document.getElementById('onlineNum');
        const currentUser       = '<%= currentUser %>';

        // ── CONNESSIONE WEBSOCKET ────────────────────────────────
        // Usa window.location.host per non dipendere dall'indirizzo hardcoded
        const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const socket     = new WebSocket(`${wsProtocol}//${window.location.host}`);

        // Mappa username → timer timeout per lo stop_typing automatico
        const typingTimers = {};

        // ── GESTIONE CONNESSIONE ─────────────────────────────────
        socket.onopen = function() {
            console.log('Connesso al server WebSocket');
            connStatus.textContent = '● CONNESSO';
            connStatus.className   = 'connected';
            sendBtn.disabled       = false;
            addSystemMessage('Connesso alla chat live');
        };

        socket.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);

                if (data.type === 'chat' || data.type === 'system') {
                    displayMessage(data);
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;

                } else if (data.type === 'typing') {
                    // Mostra indicatore "X sta scrivendo..."
                    showTyping(data.username);

                } else if (data.type === 'stop_typing') {
                    // Nasconde indicatore per quell'utente
                    hideTyping(data.username);

                } else if (data.type === 'online_count') {
                    // Aggiorna il contatore utenti online
                    onlineNum.textContent = data.count;
                }
            } catch (error) {
                console.error('Errore nel parsing del messaggio:', error);
            }
        };

        socket.onclose = function() {
            console.log('Disconnesso dal server WebSocket');
            connStatus.textContent = '● DISCONNESSO';
            connStatus.className   = 'disconnected';
            sendBtn.disabled       = true;
            addSystemMessage('Disconnesso dalla chat. Ricarica la pagina per riconnetterti.');
        };

        socket.onerror = function(error) {
            console.error('Errore WebSocket:', error);
            addSystemMessage('Errore di connessione. Ricarica la pagina.');
        };

        // ── INVIO MESSAGGI ───────────────────────────────────────
        messageForm.addEventListener('submit', function(event) {
            event.preventDefault();
            const msg = messageInput.value.trim();
            if (msg && socket.readyState === WebSocket.OPEN) {
                socket.send(JSON.stringify({ type: 'chat', message: msg }));
                messageInput.value = '';
                // Invia stop_typing al submit
                socket.send(JSON.stringify({ type: 'stop_typing' }));
            }
        });

        // Invio con Enter (senza Shift)
        messageInput.addEventListener('keydown', function(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                messageForm.dispatchEvent(new Event('submit'));
            }
        });

        // ── INDICATORE DI DIGITAZIONE (invio) ───────────────────
        // Invia 'typing' quando l'utente scrive, 'stop_typing' dopo 2s di inattività
        let typingTimeout;
        messageInput.addEventListener('input', function() {
            if (socket.readyState !== WebSocket.OPEN) return;
            socket.send(JSON.stringify({ type: 'typing' }));
            clearTimeout(typingTimeout);
            // Stop_typing automatico dopo 2 secondi senza input
            typingTimeout = setTimeout(() => {
                socket.send(JSON.stringify({ type: 'stop_typing' }));
            }, 2000);
        });

        // ── RENDERING MESSAGGI ───────────────────────────────────
        function displayMessage(data) {
            const div = document.createElement('div');
            if (data.type === 'system') {
                // Messaggi di sistema (giallo, centrati)
                div.className = 'message system-message';
                div.innerHTML = `
                    <div class="message-content">${escapeHtml(data.message)}</div>
                    <span class="message-time">${formatTime(data.timestamp)}</span>
                `;
            } else if (data.type === 'chat') {
                // Messaggi chat: a destra se miei, a sinistra se altrui
                const isMe    = data.username === currentUser;
                div.className = `message ${isMe ? 'my-message' : 'other-message'}`;
                div.innerHTML = `
                    <div class="message-header">
                        <span class="message-username">${escapeHtml(data.username)}</span>
                        <span class="message-time">${formatTime(data.timestamp)}</span>
                    </div>
                    <div class="message-content">${escapeHtml(data.message)}</div>
                `;
            }
            messagesContainer.appendChild(div);
        }

        // Aggiunge un messaggio di sistema locale (non broadcastato)
        function addSystemMessage(text) {
            const div     = document.createElement('div');
            div.className = 'message system-message';
            div.innerHTML = `
                <div class="message-content">${text}</div>
                <span class="message-time">${formatTime(new Date().toISOString())}</span>
            `;
            messagesContainer.appendChild(div);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // ── INDICATORE DI DIGITAZIONE (ricezione) ───────────────
        // Tiene traccia di chi sta scrivendo in un Set
        const whoIsTyping = new Set();

        function showTyping(username) {
            whoIsTyping.add(username);
            updateTypingUI();
            // Nascondi automaticamente dopo 3s se non arriva stop_typing
            clearTimeout(typingTimers[username]);
            typingTimers[username] = setTimeout(() => hideTyping(username), 3000);
        }

        function hideTyping(username) {
            whoIsTyping.delete(username);
            clearTimeout(typingTimers[username]);
            updateTypingUI();
        }

        function updateTypingUI() {
            const names = [...whoIsTyping];
            if (names.length === 0) {
                typingIndicator.textContent = '';
            } else if (names.length === 1) {
                typingIndicator.textContent = `${names[0]} sta scrivendo...`;
            } else {
                typingIndicator.textContent = `${names.join(', ')} stanno scrivendo...`;
            }
        }

        // ── BARRA EMOJI RAPIDA ───────────────────────────────────
        // Emoji predefinite per inserimento rapido nel campo messaggio
        const QUICK_EMOJIS = ['😂','😎','🔥','❤️','👾','🤖','⚡','🌐','💀','🚀','✨','😈'];
        const emojiBar     = document.getElementById('emojiBar');

        QUICK_EMOJIS.forEach(emoji => {
            const btn     = document.createElement('button');
            btn.type      = 'button';
            btn.className = 'emoji-btn';
            btn.textContent = emoji;
            btn.title     = `Inserisci ${emoji}`;
            btn.addEventListener('click', () => {
                // Inserisce l'emoji alla posizione del cursore
                const start = messageInput.selectionStart;
                const end   = messageInput.selectionEnd;
                const val   = messageInput.value;
                messageInput.value = val.slice(0, start) + emoji + val.slice(end);
                messageInput.setSelectionRange(start + emoji.length, start + emoji.length);
                messageInput.focus();
            });
            emojiBar.appendChild(btn);
        });

        // ── UTILITY ──────────────────────────────────────────────
        function formatTime(isoString) {
            return new Date(isoString).toLocaleTimeString('it-IT', {
                hour: '2-digit', minute: '2-digit'
            });
        }

        // Escaping HTML per sicurezza XSS
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Scroll iniziale in fondo
        window.addEventListener('load', () => {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });
    </script>
</body>
</html>
