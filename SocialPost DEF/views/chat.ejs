<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat - Messaggistica Istantanea</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            position: relative;
            color: #ffffff; 
            min-height: 100vh;
            overflow-x: hidden;
        }
        .background-gif {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
        }
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.493); 
            z-index: -1;
        }
        .navbar {
            background-color: rgba(2, 17, 76, 0.95) !important;
            border-bottom: 2px solid #0dcaf0;
        }
        .chat-container {
            background-color: rgba(10, 10, 20, 0.9);
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #0dcaf0;
            height: 80vh;
            display: flex;
            flex-direction: column;
        }
        #messages {
            flex-grow: 1;
            overflow-y: auto;
            padding: 10px;
            margin-bottom: 15px;
            background-color: rgba(20, 20, 30, 0.7);
            border-radius: 5px;
            border: 1px solid #333;
        }
        .message {
            margin-bottom: 10px;
            padding: 8px 12px;
            border-radius: 8px;
            max-width: 80%;
            word-wrap: break-word;
        }
        .my-message {
            background-color: rgba(13, 202, 240, 0.2);
            border: 1px solid #0dcaf0;
            margin-left: auto;
        }
        .other-message {
            background-color: rgba(108, 117, 125, 0.2);
            border: 1px solid #6c757d;
        }
        .system-message {
            background-color: rgba(255, 193, 7, 0.1);
            border: 1px solid #ffc107;
            text-align: center;
            max-width: 100%;
            font-style: italic;
            color: #ffc107;
        }
        .message-header {
            font-size: 0.8em;
            margin-bottom: 3px;
            display: flex;
            justify-content: space-between;
        }
        .message-username {
            font-weight: bold;
            color: #0dcaf0;
        }
        .message-time {
            color: #aaaaaa;
            font-size: 0.75em;
        }
        .message-content {
            font-size: 0.95em;
        }
        .message-form {
            margin-top: auto;
        }
        .message-input {
            background-color: rgba(67, 67, 67, 0.8) !important;
            color: #ffffff !important;
            border: 1px solid #444 !important;
        }
        .message-input:focus {
            border-color: #0dcaf0 !important;
            box-shadow: 0 0 0 0.25rem rgba(13, 202, 240, 0.25) !important;
        }
        .btn-outline-light {
            border-color: #ffffff;
            color: #ffffff;
        }
        #messages::-webkit-scrollbar {
            width: 8px;
        }
        #messages::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 4px;
        }
        #messages::-webkit-scrollbar-thumb {
            background: #0dcaf0;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <img src="/background.gif" class="background-gif" alt="Background">
    <div class="overlay"></div>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand text-white" href="/">Pagina Home</a>
            <div>
                <% if (currentUser) { %>
                    <span class="text-white me-3">Chat come <span class="welcome-text"><%= currentUser %></span></span>
                    <a href="/" class="btn btn-primary btn-sm me-2">Home</a>
                    <a href="/post" class="btn btn-primary btn-sm me-2">Nuovo Post</a>
                    <a href="/logout" class="btn btn-outline-light btn-sm">Esci</a>
                <% } else { %>
                    <a class="btn btn-outline-light me-2" href="/signup">Registrati</a>
                    <a class="btn btn-outline-light" href="/login">Accedi</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container chat-container">
        <h2 class="text-center mb-4 welcome-text">Chat Live</h2>
        
        <div id="messages">
            <div class="message system-message">
                <div class="message-content">
                    Benvenuto nella chat! I messaggi verranno visualizzati qui.
                </div>
            </div>
        </div>
        
        <form id="messageForm" class="message-form">
            <div class="input-group">
                <input type="text" id="messageInput" class="form-control message-input" 
                       placeholder="Scrivi il tuo messaggio..." autocomplete="off" required>
                <button type="submit" class="btn btn-primary">Invia</button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        const socket = new WebSocket('ws://localhost:3000');
        const messagesContainer = document.getElementById('messages');
        const messageForm = document.getElementById('messageForm');
        const messageInput = document.getElementById('messageInput');
        const currentUser = '<%= currentUser %>';
        
        socket.onopen = function() {
            console.log('Connesso al server WebSocket');
            addSystemMessage('Connesso alla chat live');
        };
        
        socket.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                displayMessage(data);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            } catch (error) {
                console.error('Errore nel parsing del messaggio:', error);
            }
        };
        
        socket.onclose = function() {
            console.log('Disconnesso dal server WebSocket');
            addSystemMessage('Disconnesso dalla chat. Ricarica la pagina per riconnetterti.');
        };
        
        socket.onerror = function(error) {
            console.error('Errore WebSocket:', error);
            addSystemMessage('Errore di connessione. Ricarica la pagina.');
        };
        
        messageForm.addEventListener('submit', function(event) {
            event.preventDefault();
            
            const message = messageInput.value.trim();
            if (message) {
                const messageData = {
                    type: 'chat',
                    message: message
                };
                
                socket.send(JSON.stringify(messageData));
                messageInput.value = '';
            }
        });
        
        messageInput.addEventListener('keydown', function(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                messageForm.dispatchEvent(new Event('submit'));
            }
        });
        
        function displayMessage(data) {
            const messageDiv = document.createElement('div');
            
            if (data.type === 'system') {
                messageDiv.className = 'message system-message';
                messageDiv.innerHTML = `
                    <div class="message-content">${data.message}</div>
                    <div class="message-time">${formatTime(data.timestamp)}</div>
                `;
            } else if (data.type === 'chat') {
                const isMyMessage = data.username === currentUser;
                messageDiv.className = `message ${isMyMessage ? 'my-message' : 'other-message'}`;
                messageDiv.innerHTML = `
                    <div class="message-header">
                        <span class="message-username">${data.username}</span>
                        <span class="message-time">${formatTime(data.timestamp)}</span>
                    </div>
                    <div class="message-content">${escapeHtml(data.message)}</div>
                `;
            }
            
            messagesContainer.appendChild(messageDiv);
        }
        
        function addSystemMessage(text) {
            const messageDiv = document.createElement('div');
            messageDiv.className = 'message system-message';
            messageDiv.innerHTML = `
                <div class="message-content">${text}</div>
                <div class="message-time">${formatTime(new Date().toISOString())}</div>
            `;
            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
        
        function formatTime(isoString) {
            const date = new Date(isoString);
            return date.toLocaleTimeString('it-IT', { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        window.addEventListener('load', function() {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });
    </script>
</body>
</html>