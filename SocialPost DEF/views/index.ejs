<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social PostIt — Home</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* ── VARIABILI & RESET ─────────────────────────────────── */
        :root {
            --bg:       #06080f;
            --bg2:      #0a0d1a;
            --bg3:      #0e1225;
            --cyan:     #00e5ff;
            --pink:     #ff2070;
            --green:    #00ff9f;
            --text:     #c8d6e5;
            --muted:    #566a80;
            --border:   rgba(0, 229, 255, 0.18);
            --glow-c:   rgba(0, 229, 255, 0.35);
            --glow-p:   rgba(255, 32, 112, 0.35);
        }
        *, *::before, *::after { box-sizing: border-box; }

        /* ── SFONDO CSS ────────────────────────────────────────── */
        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background-color: var(--bg);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }
        /* Griglia cibernetica */
        body::before {
            content: '';
            position: fixed; inset: 0;
            background:
                linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
            background-size: 44px 44px;
            z-index: -2; pointer-events: none;
        }
        /* Scanlines sottili */
        body::after {
            content: '';
            position: fixed; inset: 0;
            background: repeating-linear-gradient(
                0deg, transparent, transparent 3px,
                rgba(0,0,0,0.12) 3px, rgba(0,0,0,0.12) 4px
            );
            z-index: -1; pointer-events: none;
        }

        /* Canvas rain di sfondo (JS lo riempie) */
        #bg-canvas {
            position: fixed; top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: -1; pointer-events: none;
            opacity: 0.18;
        }

        /* Alone ciano in alto a destra */
        .cyber-orb {
            position: fixed; width: 700px; height: 700px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(0,229,255,0.07) 0%, transparent 70%);
            top: -300px; right: -250px;
            z-index: -1; pointer-events: none;
            animation: orb-pulse 7s ease-in-out infinite;
        }
        /* Alone rosa in basso a sinistra */
        .cyber-orb-2 {
            position: fixed; width: 500px; height: 500px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(255,32,112,0.06) 0%, transparent 70%);
            bottom: -200px; left: -150px;
            z-index: -1; pointer-events: none;
            animation: orb-pulse 9s ease-in-out infinite reverse;
        }
        /* Alone verde in basso a destra */
        .cyber-orb-3 {
            position: fixed; width: 350px; height: 350px; border-radius: 50%;
            background: radial-gradient(ellipse, rgba(0,255,159,0.04) 0%, transparent 70%);
            bottom: 20%; right: 5%;
            z-index: -1; pointer-events: none;
            animation: orb-pulse 11s ease-in-out infinite;
        }
        @keyframes orb-pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.5; transform: scale(1.1); }
        }

        /* ── NAVBAR ─────────────────────────────────────────────── */
        .navbar {
            background: rgba(6, 8, 15, 0.92) !important;
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            box-shadow: 0 1px 30px rgba(0,229,255,0.08);
            padding: 10px 0;
        }
        .navbar-brand {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px; font-weight: 700;
            color: var(--cyan) !important;
            letter-spacing: 2px; text-transform: uppercase;
            text-shadow: 0 0 12px var(--glow-c);
        }
        .navbar-brand span { color: var(--pink); text-shadow: 0 0 12px var(--glow-p); }
        .navbar-brand::before {
            content: '//'; color: var(--muted); margin-right: 8px;
            font-size: 14px; font-family: 'Share Tech Mono', monospace;
        }
        .nav-user-tag {
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px; color: var(--muted); margin-right: 14px;
        }
        .nav-user-tag span { color: var(--cyan); text-shadow: 0 0 8px var(--glow-c); }

        /* ── PULSANTI NAVBAR ────────────────────────────────────── */
        .btn-cyber {
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px; font-weight: 600;
            letter-spacing: 1px; text-transform: uppercase;
            border-radius: 4px; padding: 6px 16px;
            transition: all 0.2s ease; position: relative;
        }
        .btn-cyber-cyan {
            background: transparent; color: var(--cyan);
            border: 1px solid rgba(0,229,255,0.5);
        }
        .btn-cyber-cyan:hover {
            background: rgba(0,229,255,0.12); border-color: var(--cyan);
            color: var(--cyan); box-shadow: 0 0 16px rgba(0,229,255,0.3);
        }
        .btn-cyber-pink {
            background: transparent; color: var(--pink);
            border: 1px solid rgba(255,32,112,0.4);
        }
        .btn-cyber-pink:hover {
            background: rgba(255,32,112,0.1); border-color: var(--pink);
            color: var(--pink); box-shadow: 0 0 16px rgba(255,32,112,0.25);
        }
        .btn-cyber-green {
            background: transparent; color: var(--green);
            border: 1px solid rgba(0,255,159,0.4);
        }
        .btn-cyber-green:hover {
            background: rgba(0,255,159,0.1); border-color: var(--green);
            color: var(--green); box-shadow: 0 0 16px rgba(0,255,159,0.25);
        }
        .btn-cyber-ghost {
            background: transparent; color: var(--muted);
            border: 1px solid rgba(86,106,128,0.4);
        }
        .btn-cyber-ghost:hover { color: var(--text); border-color: var(--muted); }

        /* ── CONTENITORE PRINCIPALE ─────────────────────────────── */
        .content-wrap { max-width: 820px; margin: 40px auto; padding: 0 16px 80px; }

        /* ── INTESTAZIONE HOME ──────────────────────────────────── */
        .home-header { text-align: center; margin-bottom: 40px; }
        .home-header h1 {
            font-family: 'Rajdhani', sans-serif;
            font-size: clamp(28px, 5vw, 42px); font-weight: 700;
            color: var(--text); letter-spacing: 1px;
        }
        .home-header h1 span {
            color: var(--cyan); text-shadow: 0 0 18px var(--glow-c);
        }
        .home-header .subtitle {
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px; color: var(--muted);
            letter-spacing: 3px; margin-top: 4px;
        }

        /* Effetto glitch sul titolo */
        @keyframes glitch {
            0%   { text-shadow: 0 0 18px var(--glow-c); }
            20%  { text-shadow: -2px 0 var(--pink), 2px 0 var(--cyan); }
            22%  { text-shadow: 0 0 18px var(--glow-c); }
            80%  { text-shadow: 0 0 18px var(--glow-c); }
            82%  { text-shadow: 2px 0 var(--green), -2px 0 var(--pink); }
            84%  { text-shadow: 0 0 18px var(--glow-c); }
            100% { text-shadow: 0 0 18px var(--glow-c); }
        }
        .glitch { animation: glitch 5s ease-in-out infinite; }

        /* ── BARRA DI RICERCA ───────────────────────────────────── */
        .search-bar {
            margin-bottom: 28px;
            position: relative;
        }
        .search-bar input {
            width: 100%;
            background: rgba(10,13,26,0.9);
            border: 1px solid rgba(0,229,255,0.2);
            border-radius: 6px;
            color: var(--text);
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px;
            padding: 10px 16px 10px 42px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .search-bar input:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(0,229,255,0.1);
        }
        .search-bar input::placeholder { color: var(--muted); }
        .search-icon {
            position: absolute; left: 14px; top: 50%;
            transform: translateY(-50%);
            color: var(--muted); font-size: 16px;
            pointer-events: none;
        }
        .search-count {
            position: absolute; right: 14px; top: 50%;
            transform: translateY(-50%);
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--muted);
        }

        /* ── POST CARD ──────────────────────────────────────────── */
        .post-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 24px 28px;
            margin-bottom: 20px;
            position: relative; overflow: hidden;
            transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
            /* Animazione di entrata */
            animation: card-in 0.4s ease both;
        }
        @keyframes card-in {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        /* Linea decorativa sinistra sfumata */
        .post-card::before {
            content: '';
            position: absolute; top: 0; left: 0;
            width: 3px; height: 100%;
            background: linear-gradient(180deg, var(--cyan), var(--pink));
            opacity: 0.5; transition: opacity 0.25s;
        }
        /* Angolo decorativo in alto a destra */
        .post-card::after {
            content: '';
            position: absolute; top: 0; right: 0;
            width: 0; height: 0;
            border-style: solid;
            border-width: 0 22px 22px 0;
            border-color: transparent rgba(0,229,255,0.15) transparent transparent;
            transition: border-color 0.25s;
        }
        .post-card:hover {
            border-color: rgba(0,229,255,0.35);
            box-shadow: 0 4px 30px rgba(0,229,255,0.1);
            transform: translateY(-2px);
        }
        .post-card:hover::before { opacity: 1; }
        .post-card:hover::after  { border-color: transparent rgba(0,229,255,0.4) transparent transparent; }

        .post-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px; font-weight: 700;
            color: #e8f0fa; letter-spacing: 0.5px; margin-bottom: 4px;
        }
        .post-content {
            font-size: 14.5px; line-height: 1.75;
            color: var(--text); margin-bottom: 12px;
        }

        /* Immagine allegata al post */
        .post-image {
            width: 100%; max-height: 340px;
            object-fit: cover; border-radius: 4px;
            border: 1px solid rgba(0,229,255,0.15);
            margin-bottom: 14px;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .post-image:hover { opacity: 0.9; }

        .post-meta {
            display: flex; align-items: center;
            gap: 12px; flex-wrap: wrap;
        }
        .author-badge {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; padding: 3px 10px; border-radius: 3px;
            background: rgba(0,229,255,0.1);
            color: var(--cyan); border: 1px solid rgba(0,229,255,0.25);
            letter-spacing: 0.5px;
        }
        .post-date {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px; color: var(--muted);
        }

        /* Hashtag */
        .post-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
        .tag-badge {
            font-family: 'Share Tech Mono', monospace;
            font-size: 10px; padding: 2px 8px; border-radius: 20px;
            background: rgba(255,32,112,0.08);
            color: var(--pink); border: 1px solid rgba(255,32,112,0.2);
            cursor: pointer; transition: all 0.15s;
        }
        .tag-badge:hover {
            background: rgba(255,32,112,0.18);
            border-color: rgba(255,32,112,0.5);
        }
        .tag-badge.active {
            background: rgba(255,32,112,0.25);
            border-color: var(--pink);
            box-shadow: 0 0 8px rgba(255,32,112,0.3);
        }

        /* Pulsante like */
        .like-btn {
            display: inline-flex; align-items: center; gap: 5px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px; padding: 3px 10px; border-radius: 3px;
            background: transparent;
            color: var(--muted); border: 1px solid rgba(86,106,128,0.3);
            cursor: pointer; transition: all 0.2s; margin-left: auto;
        }
        .like-btn:hover {
            color: var(--pink); border-color: rgba(255,32,112,0.4);
            background: rgba(255,32,112,0.05);
        }
        .like-btn.liked {
            color: var(--pink); border-color: rgba(255,32,112,0.5);
            background: rgba(255,32,112,0.08);
            box-shadow: 0 0 8px rgba(255,32,112,0.2);
        }
        /* Animazione pop del like */
        @keyframes like-pop { 0%{transform:scale(1)} 50%{transform:scale(1.35)} 100%{transform:scale(1)} }
        .like-pop { animation: like-pop 0.3s ease; }

        /* ── STATO VUOTO ────────────────────────────────────────── */
        .empty-state { text-align: center; padding: 80px 20px; }
        .empty-state .icon { font-size: 48px; margin-bottom: 16px; opacity: 0.4; }
        .empty-state p {
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px; color: var(--muted); letter-spacing: 1px;
        }

        /* ── TOAST NOTIFICA ─────────────────────────────────────── */
        .toast-container {
            position: fixed; bottom: 24px; right: 24px;
            z-index: 9999; display: flex; flex-direction: column; gap: 8px;
        }
        .toast-msg {
            background: var(--bg2); border: 1px solid var(--border);
            border-radius: 4px; padding: 10px 16px;
            font-family: 'Share Tech Mono', monospace; font-size: 12px;
            color: var(--cyan); box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            animation: toast-in 0.3s ease;
            min-width: 200px;
        }
        @keyframes toast-in {
            from { opacity: 0; transform: translateX(20px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ── LIGHTBOX IMMAGINE ──────────────────────────────────── */
        .lightbox {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.92); z-index: 9998;
            align-items: center; justify-content: center;
            cursor: zoom-out;
        }
        .lightbox.open { display: flex; }
        .lightbox img {
            max-width: 90vw; max-height: 90vh;
            border-radius: 4px; border: 1px solid var(--border);
        }

        /* ── SCROLLBAR ──────────────────────────────────────────── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: rgba(0,229,255,0.3); border-radius: 3px; }

        /* Nasconde post filtrati */
        .post-card.hidden { display: none; }
    </style>
</head>
<body>
    <!-- Canvas per l'effetto rain/particelle di sfondo -->
    <canvas id="bg-canvas"></canvas>

    <!-- Aloni decorativi CSS -->
    <div class="cyber-orb"></div>
    <div class="cyber-orb-2"></div>
    <div class="cyber-orb-3"></div>

    <!-- ── NAVBAR ──────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Social <span>PostIt</span></a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <% if (currentUser) { %>
                    <span class="nav-user-tag">> <span><%= currentUser %></span></span>
                    <a href="/post"   class="btn btn-cyber btn-cyber-cyan btn-sm">Nuovo Post</a>
                    <a href="/chat"   class="btn btn-cyber btn-cyber-green btn-sm">Chat Live</a>
                    <a href="/logout" class="btn btn-cyber btn-cyber-pink btn-sm">Esci</a>
                <% } else { %>
                    <a href="/signup" class="btn btn-cyber btn-cyber-ghost btn-sm">Registrati</a>
                    <a href="/login"  class="btn btn-cyber btn-cyber-cyan btn-sm">Accedi</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- ── CONTENUTO PRINCIPALE ────────────────────────────────── -->
    <div class="content-wrap">
        <div class="home-header">
            <h1>
                <% if (currentUser) { %>
                    Bentornato, <span class="glitch"><%= currentUser %></span>
                <% } else { %>
                    <span class="glitch">Social</span> PostIt
                <% } %>
            </h1>
            <div class="subtitle">
                <% if (currentUser) { %>
                    // FEED AGGIORNATO — <%= posts ? posts.length : 0 %> POST
                <% } else { %>
                    // PIATTAFORMA OPEN — ACCEDI PER POSTARE
                <% } %>
            </div>
        </div>

        <!-- Barra di ricerca (visibile solo se ci sono post) -->
        <% if (posts && posts.length > 0) { %>
        <div class="search-bar">
            <span class="search-icon">🔍</span>
            <input type="text" id="searchInput"
                   placeholder="Cerca per titolo, autore o #tag..."
                   autocomplete="off">
            <span class="search-count" id="searchCount"></span>
        </div>
        <% } %>

        <!-- Lista post -->
        <% if (posts && posts.length > 0) { %>
            <%
                // Calcola l'indice reale per ogni post (per la route /like)
                const reversed = posts.slice().map((p, i) => ({ ...p, realIndex: i })).reverse();
            %>
            <% reversed.forEach((post, loopIdx) => { %>
                <%
                    const liked = currentUser && post.likes && post.likes.includes(currentUser);
                    const likeCount = post.likes ? post.likes.length : 0;
                %>
                <div class="post-card"
                     data-title="<%= (post.title || '').toLowerCase() %>"
                     data-author="<%= (post.author || '').toLowerCase() %>"
                     data-tags="<%= (post.tags || []).join(' ').toLowerCase() %>"
                     style="animation-delay: <%= loopIdx * 0.07 %>s">

                    <!-- Titolo e autore -->
                    <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                        <div class="post-title"><%= post.title || "Senza titolo" %></div>
                        <% if (post.author) { %>
                            <span class="author-badge"><%= post.author %></span>
                        <% } %>
                    </div>

                    <!-- Tag/hashtag -->
                    <% if (post.tags && post.tags.length > 0) { %>
                        <div class="post-tags">
                            <% post.tags.forEach(tag => { %>
                                <span class="tag-badge" data-tag="<%= tag.toLowerCase() %>">#<%= tag %></span>
                            <% }) %>
                        </div>
                    <% } %>

                    <!-- Contenuto testuale -->
                    <p class="post-content"><%= post.content || "" %></p>

                    <!-- Immagine allegata (se presente) -->
                    <% if (post.image) { %>
                        <img src="<%= post.image %>"
                             alt="Immagine del post"
                             class="post-image"
                             onclick="openLightbox(this.src)">
                    <% } %>

                    <!-- Meta: data + like -->
                    <div class="post-meta">
                        <% if (post.date) { %>
                            <span class="post-date">📅 <%= post.date %></span>
                        <% } %>
                        <!-- Pulsante like: visibile solo se loggato -->
                        <% if (currentUser) { %>
                            <button class="like-btn <%= liked ? 'liked' : '' %>"
                                    data-index="<%= post.realIndex %>"
                                    onclick="toggleLike(this)">
                                ♥ <span class="like-count"><%= likeCount %></span>
                            </button>
                        <% } else if (likeCount > 0) { %>
                            <span class="like-btn" style="cursor:default;">
                                ♥ <span class="like-count"><%= likeCount %></span>
                            </span>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <div class="icon">📭</div>
                <p>// NESSUN POST TROVATO</p>
                <% if (currentUser) { %>
                    <a href="/post" class="btn btn-cyber btn-cyber-cyan mt-3">Crea il primo post</a>
                <% } else { %>
                    <p class="mt-2">Accedi per pubblicare il primo contenuto</p>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Lightbox immagine -->
    <div class="lightbox" id="lightbox" onclick="closeLightbox()">
        <img id="lightbox-img" src="" alt="Immagine ingrandita">
    </div>

    <!-- Toast container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        /* ── CANVAS BACKGROUND (pioggia di caratteri cyberpunk) ── */
        (function() {
            const canvas = document.getElementById('bg-canvas');
            const ctx    = canvas.getContext('2d');
            let W, H, drops = [];
            const chars  = '01アイウエオカキクケコサシスセソ<>{}[]//\\#@$%&*';

            function resize() {
                W = canvas.width  = window.innerWidth;
                H = canvas.height = window.innerHeight;
                drops = Array.from({ length: Math.floor(W / 22) }, () => Math.random() * H);
            }
            window.addEventListener('resize', resize);
            resize();

            function draw() {
                ctx.fillStyle = 'rgba(6,8,15,0.05)';
                ctx.fillRect(0, 0, W, H);
                ctx.font = '13px "Share Tech Mono", monospace';
                drops.forEach((y, i) => {
                    const char = chars[Math.floor(Math.random() * chars.length)];
                    const x    = i * 22;
                    // Alterna ciano e verde per le lettere
                    ctx.fillStyle = Math.random() > 0.85
                        ? 'rgba(0,255,159,0.8)'
                        : 'rgba(0,229,255,0.5)';
                    ctx.fillText(char, x, y);
                    if (y > H && Math.random() > 0.975) drops[i] = 0;
                    drops[i] += 16;
                });
            }
            setInterval(draw, 60);
        })();

        /* ── SISTEMA LIKE ────────────────────────────────────────── */
        function toggleLike(btn) {
            const index = btn.dataset.index;
            fetch('/like', {
                method:  'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    `postIndex=${index}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.error) return;
                const countEl = btn.querySelector('.like-count');
                countEl.textContent = data.likes;
                btn.classList.toggle('liked', data.liked);
                btn.classList.add('like-pop');
                btn.addEventListener('animationend', () => btn.classList.remove('like-pop'), { once: true });
                showToast(data.liked ? '♥ Post apprezzato!' : '♡ Like rimosso');
            })
            .catch(() => showToast('Errore nel like'));
        }

        /* ── RICERCA/FILTRO POST ─────────────────────────────────── */
        const searchInput = document.getElementById('searchInput');
        const searchCount = document.getElementById('searchCount');
        const cards       = document.querySelectorAll('.post-card');

        if (searchInput) {
            searchInput.addEventListener('input', filterPosts);
        }

        // Filtro per tag quando si clicca un badge
        document.querySelectorAll('.tag-badge').forEach(badge => {
            badge.addEventListener('click', () => {
                const tag = badge.dataset.tag;
                // Se il campo di ricerca già contiene questo tag, lo rimuove
                if (searchInput.value.trim() === `#${tag}`) {
                    searchInput.value = '';
                } else {
                    searchInput.value = `#${tag}`;
                }
                filterPosts();
            });
        });

        function filterPosts() {
            const q = (searchInput ? searchInput.value.trim().toLowerCase() : '');
            let visible = 0;

            cards.forEach(card => {
                if (!q) {
                    card.classList.remove('hidden');
                    visible++;
                    return;
                }
                // Cerca nel titolo, autore, tag (con o senza #)
                const query    = q.startsWith('#') ? q.slice(1) : q;
                const inTitle  = card.dataset.title.includes(query);
                const inAuthor = card.dataset.author.includes(query);
                const inTags   = card.dataset.tags.includes(query);
                const match    = inTitle || inAuthor || inTags;
                card.classList.toggle('hidden', !match);
                if (match) visible++;
            });

            // Aggiorna il contatore
            if (searchCount) {
                searchCount.textContent = q
                    ? `${visible}/${cards.length}`
                    : '';
            }

            // Aggiorna l'evidenziazione dei tag attivi
            document.querySelectorAll('.tag-badge').forEach(b => {
                const isActive = q === `#${b.dataset.tag}`;
                b.classList.toggle('active', isActive);
            });
        }

        /* ── LIGHTBOX IMMAGINE ───────────────────────────────────── */
        function openLightbox(src) {
            document.getElementById('lightbox-img').src = src;
            document.getElementById('lightbox').classList.add('open');
        }
        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('open');
        }
        // Chiude lightbox con ESC
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeLightbox();
        });

        /* ── TOAST ───────────────────────────────────────────────── */
        function showToast(msg, duration = 2500) {
            const container = document.getElementById('toastContainer');
            const el        = document.createElement('div');
            el.className    = 'toast-msg';
            el.textContent  = msg;
            container.appendChild(el);
            setTimeout(() => el.remove(), duration);
        }
    </script>
</body>
</html>
