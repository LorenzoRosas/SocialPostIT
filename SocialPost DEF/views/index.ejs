<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pagina Home</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            position: relative;
            color: #ffffff; 
            min-height: 100vh;
            overflow-x: hidden;
        }
        .background-gif {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
        }
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.493); 
            z-index: -1;
        }
        .navbar {
            background-color: rgba(2, 17, 76, 0.95) !important;
            border-bottom: 2px solid #0dcaf0;
        }
        .content-container {
            background-color: rgba(10, 10, 20, 0.9);
            border-radius: 8px;
            padding: 25px;
            margin-top: 20px;
            border: 1px solid #0dcaf0;
        }
        .list-group-item {
            background-color: rgba(20, 20, 30, 0.9) !important;
            border: 1px solid #333;
            color: #ffffff;
        }
        .welcome-text {
            color: #0dcaf0 !important;
            font-weight: bold;
            text-shadow: 0 0 8px rgba(13, 202, 240, 0.7);
        }
        .text-muted {
            color: #aaaaaa !important; 
        }
        .author-badge {
            background-color: #0d6efd;
            color: white;
            font-weight: bold;
        }
        .btn-outline-light {
            border-color: #ffffff;
            color: #ffffff;
        }
        .btn-chat {
            background-color: #28a745;
            border-color: #28a745;
            color: white;
        }
        .btn-chat:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }
    </style>
</head>
<body>
    <img src="/background.gif" class="background-gif" alt="Background">
    <div class="overlay"></div>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand text-white" href="/">Pagina Home</a>
            <div>
                <% if (currentUser) { %>
                    <span class="text-white me-3">Benvenuto, <span class="welcome-text"><%= currentUser %></span>!</span>
                    <a href="/post" class="btn btn-primary btn-sm me-2">Nuovo Post</a>
                    <a href="/chat" class="btn btn-chat btn-sm me-2">Chat Live</a>
                    <a href="/logout" class="btn btn-outline-light btn-sm">Esci</a>
                <% } else { %>
                    <a class="btn btn-outline-light me-2" href="/signup">Registrati</a>
                    <a class="btn btn-outline-light" href="/login">Accedi</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container content-container mt-4">
        <h1 class="text-center mb-4 welcome-text">
            <% if (currentUser) { %>
                Bentornato, <%= currentUser %>!
            <% } else { %>
                Benvenuto!
            <% } %>
        </h1>

        <div class="list-group mt-4">
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <div class="list-group-item p-4 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="mb-0 text-white">
                                <%= post.title || "Titolo non disponibile" %>
                            </h4>
                            <% if (post.author) { %>
                                <span class="author-badge badge rounded-pill"><%= post.author %></span>
                            <% } %>
                        </div>
                        <p class="mb-2 text-white">
                            <%= post.content || "Contenuto non disponibile" %>
                        </p>
                        <% if (post.date) { %>
                            <small class="text-muted">Pubblicato il <%= post.date %></small>
                        <% } %>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-5">
                    <h5 class="text-muted">Nessun post ancora pubblicato</h5>
                    <% if (currentUser) { %>
                        <a href="/post" class="btn btn-primary mt-3">Crea il primo post</a>
                    <% } else { %>
                        <p class="text-muted">Accedi per creare un post</p>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>