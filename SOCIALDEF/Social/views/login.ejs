<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Social PostIt - Accedi</title>
    <!-- Bootstrap CSS per layout responsive -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- Font Google: Rajdhani, Share Tech Mono, Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Foglio di stile principale (sfondo unificato con le altre pagine) -->
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="auth-page auth-login-page">
    <!-- Aloni decorativi CSS - stessi di tutte le altre pagine -->
    <div class="cyber-orb"></div>
    <div class="cyber-orb-2"></div>
    <div class="cyber-orb-3"></div>

    <!-- ══ NAVBAR ════════════════════════════════════════════════════════════ -->
    <nav class="navbar navbar-dark">
        <div class="container">
            <!-- Logo del sito -->
            <a class="navbar-brand" href="/">Social <span>PostIt</span></a>
            <!-- Link utili nella navbar -->
            <div class="d-flex align-items-center gap-2">
                <!-- Link alla ricerca -->
                <a href="/search" class="btn btn-cyber btn-cyber-cyan btn-sm">Ricerca</a>
                <!-- Link alla registrazione -->
                <a href="/signup" class="btn btn-cyber btn-cyber-ghost btn-sm">Registrati</a>
            </div>
        </div>
    </nav>

    <!-- ══ CONTENUTO PRINCIPALE ══════════════════════════════════════════════ -->
    <main class="auth-shell">

        <!-- Pannello hero con due colonne: testo + form -->
        <section class="auth-hero-panel glass-panel">

            <!-- Colonna sinistra: titolo descrittivo -->
            <div class="auth-copy">
                <!-- Titolo grande della pagina -->
                <h1 class="auth-display">Accedi al tuo account</h1>
            </div>

            <!-- Colonna destra: card con il form di login -->
            <div class="auth-card">

                <!-- Intestazione della card -->
                <div class="auth-card-top">
                    <!-- Etichetta kicker -->
                    <span class="auth-card-kicker">Login</span>
                    <!-- Sottotitolo -->
                    <h2 class="auth-card-title">Accedi al tuo spazio</h2>
                </div>

                <!-- Banner di errore (visibile solo se c'è un errore) -->
                <% if (error) { %>
                    <div class="auth-error-banner"><%= error %></div>
                <% } %>

                <!-- Form di login: invia a POST /login -->
                <form action="/login" method="POST" class="auth-form">

                    <!-- Campo username -->
                    <div class="auth-field">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username"
                               class="auth-input"
                               placeholder="il tuo username"
                               required autofocus>
                    </div>

                    <!-- Campo password -->
                    <div class="auth-field">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password"
                               class="auth-input"
                               placeholder="••••••••"
                               required>
                    </div>

                    <!-- Pulsante di submit con stile cyan -->
                    <button type="submit" class="auth-submit auth-submit-cyan">Accedi</button>
                </form>

                <!-- Footer con link alla registrazione -->
                <div class="auth-footer-row">
                    <span>Nuovo su Social PostIt?</span>
                    <a href="/signup">Crea un account</a>
                </div>

            </div>
            <!-- Fine auth-card -->

        </section>
        <!-- Fine auth-hero-panel -->

    </main>
</body>
</html>
