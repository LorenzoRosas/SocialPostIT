<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Social PostIt</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <!-- Font Google -->
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Foglio di stile principale (sfondo unificato) -->
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="error-page">
    <!-- Aloni decorativi CSS -->
    <div class="cyber-orb"></div>
    <div class="cyber-orb-2"></div>
    <div class="cyber-orb-3"></div>

    <!-- ══ CONTENUTO PRINCIPALE ══════════════════════════════════════════════ -->
    <main class="error-shell">

        <!-- Pannello centrale con il messaggio di errore -->
        <section class="error-panel glass-panel">

            <!-- Etichetta kicker sopra il codice errore -->
            <span class="error-kicker">Broken Link</span>

            <!-- Codice errore grande -->
            <div class="error-code">404</div>

            <!-- Titolo dell'errore -->
            <h1 class="error-title">Pagina non trovata</h1>

            <!-- Descrizione dell'errore -->
            <p class="error-copy">
                Il percorso che hai aperto non esiste oppure non è più disponibile.
            </p>

            <!-- Azioni disponibili -->
            <div class="error-actions">
                <!-- Torna alla home -->
                <a href="/" class="btn btn-cyber btn-cyber-cyan btn-sm">Torna alla Home</a>
                <!-- Vai alla ricerca -->
                <a href="/search" class="btn btn-cyber btn-cyber-ghost btn-sm">Vai alla Ricerca</a>
            </div>

        </section>
    </main>
</body>
</html>
