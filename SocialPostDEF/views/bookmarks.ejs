<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Segnalibri — Social PostIt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg:       #06080f;
            --bg2:      #0a0d1a;
            --cyan:     #00e5ff;
            --pink:     #ff2070;
            --green:    #00ff9f;
            --text:     #c8d6e5;
            --muted:    #566a80;
            --border:   rgba(0, 229, 255, 0.18);
        }
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background-color: var(--bg);
            min-height: 100vh;
            position: relative;
        }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
            background-size: 44px 44px;
            z-index: -2;
            pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(
                0deg, transparent, transparent 3px,
                rgba(0,0,0,0.12) 3px, rgba(0,0,0,0.12) 4px
            );
            z-index: -1;
            pointer-events: none;
        }

        .navbar {
            background: rgba(6, 8, 15, 0.7) !important;
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 10px 0;
        }
        .navbar-brand {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: var(--cyan) !important;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .navbar-brand span {
            color: var(--pink);
        }
        .btn-cyber {
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 4px;
            padding: 6px 16px;
        }
        .btn-cyber-cyan {
            background: transparent;
            color: var(--cyan);
            border: 1px solid rgba(0,229,255,0.5);
        }

        .content-wrap {
            max-width: 820px;
            margin: 40px auto;
            padding: 0 16px 80px;
        }

        .page-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 28px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }
        .page-subtitle {
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            color: var(--muted);
            letter-spacing: 2px;
            margin-bottom: 32px;
        }

        .post-card {
            background: rgba(10, 13, 26, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 20px;
            margin-bottom: 16px;
            transition: border-color 0.2s;
        }
        .post-card:hover {
            border-color: rgba(0,229,255,0.35);
        }
        .post-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }
        .post-content {
            font-size: 13px;
            line-height: 1.6;
            color: var(--text);
            margin-bottom: 8px;
        }
        .post-meta {
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px;
            color: var(--muted);
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }
        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.4;
        }
        .empty-state p {
            font-family: 'Share Tech Mono', monospace;
            font-size: 12px;
            color: var(--muted);
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Social <span>PostIt</span></a>
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-cyber btn-cyber-cyan btn-sm">Home</a>
                <a href="/logout" class="btn btn-cyber btn-cyber-pink btn-sm" style="border-color: rgba(255,32,112,0.4); color: var(--pink);">Esci</a>
            </div>
        </div>
    </nav>

    <div class="content-wrap">
        <div class="page-title">📌 Segnalibri</div>
        <div class="page-subtitle">// POST SALVATI PER LEGGERE DOPO</div>

        <% if (bookmarkedPosts && bookmarkedPosts.length > 0) { %>
            <% bookmarkedPosts.forEach(post => { %>
                <div class="post-card">
                    <div class="post-title"><%= post.title || "Senza titolo" %></div>
                    <div class="post-content">
                        <%= post.content.substring(0, 120) %><% if (post.content.length > 120) { %>...<% } %>
                    </div>
                    <div class="post-meta">
                        <span>Autore: <%= post.author %></span> •
                        <span><%= post.date %></span>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <div class="icon">📭</div>
                <p>// NESSUN POST SALVATO</p>
                <p style="margin-top: 8px;">Visita la home e salva i post che preferisci</p>
            </div>
        <% } %>
    </div>
</body>
</html>