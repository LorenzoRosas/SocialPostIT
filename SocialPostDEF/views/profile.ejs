<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= targetUser.username %> — Profilo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* =====================================================================
           VARIABILI E RESET – Tema cyberpunk/glass
           ===================================================================== */
        :root {
            --bg:       #06080f;
            --bg2:      #0a0d1a;
            --bg3:      #0e1225;
            --cyan:     #00e5ff;
            --pink:     #ff2070;
            --green:    #00ff9f;
            --text:     #c8d6e5;
            --muted:    #566a80;
            --border:   rgba(0, 229, 255, 0.18);
            --glow-c:   rgba(0, 229, 255, 0.35);
            --glow-p:   rgba(255, 32, 112, 0.35);
        }
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background-color: var(--bg);
            min-height: 100vh;
            position: relative;
        }
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
            background-size: 44px 44px;
            z-index: -2;
            pointer-events: none;
        }
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(
                0deg, transparent, transparent 3px,
                rgba(0,0,0,0.12) 3px, rgba(0,0,0,0.12) 4px
            );
            z-index: -1;
            pointer-events: none;
        }
        .cyber-orb {
            position: fixed;
            width: 700px;
            height: 700px;
            border-radius: 50%;
            background: radial-gradient(ellipse, rgba(0,229,255,0.07) 0%, transparent 70%);
            top: -300px;
            right: -250px;
            z-index: -1;
            pointer-events: none;
        }

        /* =====================================================================
           NAVBAR – Glass
           ===================================================================== */
        .navbar {
            background: rgba(6, 8, 15, 0.7) !important;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            padding: 10px 0;
        }
        .navbar-brand {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: var(--cyan) !important;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-shadow: 0 0 12px var(--glow-c);
        }
        .navbar-brand span {
            color: var(--pink);
            text-shadow: 0 0 12px var(--glow-p);
        }
        .navbar-brand::before {
            content: '//';
            color: var(--muted);
            margin-right: 8px;
            font-size: 14px;
            font-family: 'Share Tech Mono', monospace;
        }
        .btn-cyber {
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 4px;
            padding: 6px 16px;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .btn-cyber-cyan {
            background: transparent;
            color: var(--cyan);
            border: 1px solid rgba(0,229,255,0.5);
        }
        .btn-cyber-cyan:hover {
            background: rgba(0,229,255,0.12);
            border-color: var(--cyan);
            box-shadow: 0 0 16px rgba(0,229,255,0.3);
        }
        .btn-cyber-pink {
            background: transparent;
            color: var(--pink);
            border: 1px solid rgba(255,32,112,0.4);
        }
        .btn-cyber-pink:hover {
            background: rgba(255,32,112,0.1);
            border-color: var(--pink);
            box-shadow: 0 0 16px rgba(255,32,112,0.25);
        }

        /* =====================================================================
           PROFILO HEADER – Glass
           ===================================================================== */
        .profile-header {
            background: linear-gradient(135deg, rgba(0,229,255,0.05), rgba(255,32,112,0.05));
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border);
            padding: 40px 20px;
            margin-bottom: 40px;
        }
        .profile-container {
            max-width: 820px;
            margin: 0 auto;
        }
        .profile-info {
            display: flex;
            gap: 24px;
            align-items: flex-start;
            flex-wrap: wrap;
        }
        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--cyan), var(--pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: 700;
            color: var(--bg);
            border: 2px solid var(--border);
            flex-shrink: 0;
        }
        .profile-details {
            flex: 1;
            min-width: 200px;
        }
        .profile-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 28px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }
        .profile-bio {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 12px;
        }
        .profile-stats {
            display: flex;
            gap: 20px;
            margin-bottom: 16px;
        }
        .stat {
            display: flex;
            flex-direction: column;
        }
        .stat-num {
            font-family: 'Rajdhani', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: var(--cyan);
        }
        .stat-label {
            font-size: 11px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-family: 'Share Tech Mono', monospace;
        }
        .profile-actions {
            display: flex;
            gap: 8px;
        }
        .profile-actions .btn {
            padding: 6px 14px;
            font-size: 12px;
        }

        /* =====================================================================
           CONTENUTO PRINCIPALE – Post dell'utente
           ===================================================================== */
        .content-wrap {
            max-width: 820px;
            margin: 0 auto;
            padding: 0 16px 80px;
        }

        .post-card {
            background: rgba(10, 13, 26, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 24px 28px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
            transition: border-color 0.25s, box-shadow 0.25s;
        }
        .post-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background: linear-gradient(180deg, var(--cyan), var(--pink));
            opacity: 0.5;
            transition: opacity 0.25s;
        }
        .post-card:hover {
            border-color: rgba(0,229,255,0.35);
            box-shadow: 0 4px 30px rgba(0,229,255,0.1);
        }
        .post-card:hover::before {
            opacity: 1;
        }

        .post-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: #e8f0fa;
            margin-bottom: 8px;
        }
        .post-content {
            font-size: 14px;
            line-height: 1.7;
            color: var(--text);
            margin-bottom: 12px;
        }
        .post-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 11px;
            color: var(--muted);
        }

        /* Stato vuoto */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }
        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.4;
        }
        .empty-state p {
            font-family: 'Share Tech Mono', monospace;
            font-size: 13px;
            color: var(--muted);
            letter-spacing: 1px;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0,229,255,0.3);
            border-radius: 3px;
        }
    </style>
</head>
<body>
    <div class="cyber-orb"></div>

    <!-- =====================================================================
         NAVBAR
         ===================================================================== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Social <span>PostIt</span></a>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <% if (currentUser) { %>
                    <a href="/search" class="btn btn-cyber btn-cyber-cyan btn-sm">Cerca</a>
                    <a href="/post" class="btn btn-cyber btn-cyber-cyan btn-sm">Nuovo Post</a>
                    <a href="/logout" class="btn btn-cyber btn-cyber-pink btn-sm">Esci</a>
                <% } else { %>
                    <a href="/login" class="btn btn-cyber btn-cyber-cyan btn-sm">Accedi</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- =====================================================================
         PROFILO HEADER
         ===================================================================== -->
    <div class="profile-header">
        <div class="profile-container">
            <div class="profile-info">
                <div class="profile-avatar"><%= targetUser.avatar %></div>
                <div class="profile-details">
                    <div class="profile-name"><%= targetUser.username %></div>
                    <% if (targetUser.bio) { %>
                        <div class="profile-bio"><%= targetUser.bio %></div>
                    <% } else { %>
                        <div class="profile-bio" style="color: rgba(200,214,229,0.3); font-style: italic;">Nessuna biografia</div>
                    <% } %>
                    <div class="profile-stats">
                        <div class="stat">
                            <span class="stat-num"><%= userPosts.length %></span>
                            <span class="stat-label">Post</span>
                        </div>
                        <div class="stat">
                            <span class="stat-num"><%= targetUser.followers ? targetUser.followers.length : 0 %></span>
                            <span class="stat-label">Follower</span>
                        </div>
                        <div class="stat">
                            <span class="stat-num"><%= targetUser.following ? targetUser.following.length : 0 %></span>
                            <span class="stat-label">Following</span>
                        </div>
                    </div>
                    <div class="profile-actions">
                        <% if (currentUser && currentUser !== targetUser.username) { %>
                            <button class="btn btn-cyber <%= isFollowing ? 'btn-cyber-pink' : 'btn-cyber-cyan' %> btn-sm"
                                    onclick="toggleFollow('<%= targetUser.username %>')">
                                <%= isFollowing ? '✓ Seguito' : '+ Segui' %>
                            </button>
                        <% } else if (currentUser === targetUser.username) { %>
                            <a href="/profile" class="btn btn-cyber btn-cyber-cyan btn-sm">Modifica Profilo</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =====================================================================
         POST DELL'UTENTE
         ===================================================================== -->
    <div class="content-wrap">
        <% if (userPosts.length > 0) { %>
            <% userPosts.forEach((post, idx) => { %>
                <div class="post-card">
                    <div class="post-title"><%= post.title || "Senza titolo" %></div>
                    <p class="post-content">
                        <%= post.content.substring(0, 150) %><% if (post.content.length > 150) { %>...<% } %>
                    </p>
                    <div class="post-meta">
                        <span>📅 <%= post.date %></span>
                        <span>♥ <%= post.likes ? post.likes.length : 0 %></span>
                        <span>💬 <%= post.comments ? post.comments.length : 0 %></span>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <div class="icon">📭</div>
                <p>// NESSUN POST DA VISUALIZZARE</p>
            </div>
        <% } %>
    </div>

    <script>
        function toggleFollow(username) {
            fetch(`/follow/${username}`, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(err => console.error('Errore:', err));
        }
    </script>
</body>
</html>